{
  "name": "d-generation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "extract:aga": "bun tools/extract-aga.ts",
    "extract:levels": "bun tools/extract-levels.ts",
    "lockstep": "bun tools/lockstep-aga.ts",
    "scenarios": "bun tools/scenarios.ts",
    "truth:aga-rooms": "uv run -q --with unicorn --with capstone python tools/m68k/room_truth.py",
    "verify:aga-rooms": "bun tools/verify-aga-rooms.ts",
    "verify:aga-frames": "bun tools/verify-aga-frames.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "chiptune3": "^0.8.9",
    "json5": "^2.2.3"
  }
}
