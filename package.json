{
  "name": "d-generation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "extract": "bun tools/extract.ts",
    "truth:rooms": "uv run -q --with unicorn tools/emu/room_truth.py",
    "verify:rooms": "bun tools/verify-rooms.ts",
    "difftest": "bun tools/difftest.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "chiptune3": "^0.8.9"
  }
}
